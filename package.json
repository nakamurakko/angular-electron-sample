{
  "name": "angular-electron-sample",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start:angular": "ng serve",
    "start:electron": "npm run build:all && electron ./dist/electron-main.js",
    "build:all": "npm run build:angular && npm run build:electron",
    "build:angular": "ng build --base-href ./",
    "build:electron": "tsc --project tsconfig.electron.json",
    "build:development:all": "npm run build:development:angular && npm run build:development:electron",
    "build:development:angular": "ng build --configuration=development --base-href ./",
    "build:development:electron": "tsc --project tsconfig.electron.development.json",
    "build-portable": "npm run build:all && electron-builder build --windows portable",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.15.0",
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.6.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "main": "dist/electron-main.js",
  "build": {
    "asar": "false",
    "directories": {
      "output": "executableFile"
    },
    "files": [
      "!.angular",
      "!.github",
      "!.npmrc",
      "!.vscode",
      "!angular.json",
      "!build-dev.bat",
      "!build-portable.bat",
      "!eslint.config.js",
      "!src",
      "!LICENSE",
      "!README.md",
      "!tsconfig*.json"
    ]
  }
}
